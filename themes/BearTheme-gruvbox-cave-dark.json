				"foreground": "#fe8019"
			}
		},
		{
			"name": "Tag",
			"scope": [
				"entity.name.tag",
				"meta.tag.sgml",
				"markup.deleted.git_gutter"
			],
			"settings": {
				"foreground": "#fb4934"
			}
		},
		{
			"name": "Function, Special Method",
